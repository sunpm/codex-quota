{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Quota",
  "version": "0.23.0",
  "identifier": "local.codexquotadock.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "Codex Quota", "width": 1140, "height": 760,
      "minWidth": 860, "minHeight": 560, "center": true, "visible": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Codex 额度与用量",
    "resources": ["../Resources/ThirdPartyNotices/"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" },
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": false } }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/sunpm/codex-quota/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
