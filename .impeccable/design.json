      "html": "<nav aria-label=\"页面示意\"><button class=\"ds-nav-selected\" type=\"button\" aria-current=\"page\">额度</button></nav>",
      "css": ".ds-nav-selected{font:600 13px system-ui;min-height:34px;padding:0 10px;border:0;border-radius:6px;color:CanvasText;background:color-mix(in srgb,Highlight 12%,transparent)}.ds-nav-selected:hover{cursor:default}.ds-nav-selected:focus-visible{outline:auto}"
