      "html": "<section class=\"ds-card\"><strong>用量历史</strong><button type=\"button\">重新扫描日志</button></section>",
      "css": ".ds-card{display:grid;gap:8px;padding:16px;border:1px solid color-mix(in srgb,CanvasText 7%,transparent);border-radius:10px;background:Canvas;color:CanvasText;font:13px system-ui}.ds-card button{appearance:auto;font:inherit;justify-self:start}.ds-card button:hover{cursor:default}.ds-card button:focus-visible{outline:auto}"
