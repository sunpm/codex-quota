      "html": "<div class=\"ds-quota\"><div class=\"ds-quota-label\"><span>5 小时额度</span><strong>58%</strong></div><div class=\"ds-quota-track\" aria-hidden=\"true\"><div></div></div></div>",
      "css": ".ds-quota{--ds-quota-normal:#6C6C70;display:grid;gap:6px;font:13px system-ui;color:CanvasText}.ds-quota-label{display:flex;align-items:baseline;justify-content:space-between;gap:12px}.ds-quota strong{font-size:24px;font-weight:600;font-variant-numeric:tabular-nums;color:var(--ds-quota-normal)}.ds-quota-track{height:6px;border-radius:9999px;overflow:hidden;background:color-mix(in srgb,GrayText 18%,transparent)}.ds-quota-track>div{height:100%;width:58%;border-radius:inherit;background:var(--ds-quota-normal)}@media(prefers-color-scheme:dark){.ds-quota{--ds-quota-normal:#98989D}}"
