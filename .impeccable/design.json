  "components": [
    {
      "name": "保存",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "提交当前编辑。",
      "html": "<button type=\"button\" class=\"ds-button\">保存</button>",
      "css": ":host { color-scheme: light dark; }\n.ds-button {display:inline-flex;align-items:center;justify-content:center;height:32px;padding:4px 12px;border:0;border-radius:6px;font:500 13px/20px -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif;cursor:pointer;background:var(--primary, light-dark(#286fae, #3178b7));color:var(--primary-foreground, #fff)}\n.ds-button:hover {background:color-mix(in srgb, var(--primary, light-dark(#286fae, #3178b7)) 90%, transparent)}\n.ds-button:focus-visible {outline:2px solid var(--primary-foreground, #fff);outline-offset:-3px}\n.ds-button:disabled {opacity:.5;pointer-events:none}"
    },
    {
      "name": "普通操作",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "打开模型定价。",
      "html": "<button type=\"button\" class=\"ds-button\">管理定价…</button>",
      "css": ":host { color-scheme: light dark; }\n.ds-button {display:inline-flex;align-items:center;justify-content:center;height:28px;padding:3px 10px;border:0;border-radius:6px;font:500 12px/20px -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif;cursor:pointer;background:var(--background, light-dark(#fafafa, #18191c));color:var(--foreground, light-dark(#252629, #e9eaed));border:1px solid var(--border, light-dark(#dedfe2, #34363d));box-shadow:0 1px 2px 0 rgb(0 0 0 / 0.05)}\n.ds-button:hover {background:var(--accent, light-dark(#e6e9ed, #32353b))}\n.ds-button:focus-visible {outline:2px solid var(--primary, light-dark(#286fae, #3178b7));outline-offset:-2px}\n.ds-button:disabled {opacity:.5;pointer-events:none}\n@media (prefers-color-scheme: dark) {.ds-button {background:color-mix(in srgb,var(--input, light-dark(#d7d9dd, #424650)) 30%,transparent);border-color:var(--input, light-dark(#d7d9dd, #424650))}.ds-button:hover {background:color-mix(in srgb,var(--input, light-dark(#d7d9dd, #424650)) 50%,transparent)}}"
    },
    {
      "name": "行内操作",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "在定价列表中编辑一行。",
      "html": "<button type=\"button\" class=\"ds-button\">编辑…</button>",
      "css": ":host { color-scheme: light dark; }\n.ds-button {display:inline-flex;align-items:center;justify-content:center;height:28px;padding:3px 10px;border:0;border-radius:6px;font:500 12px/20px -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif;cursor:pointer;background:transparent;color:var(--foreground, light-dark(#252629, #e9eaed))}\n.ds-button:hover {background:var(--accent, light-dark(#e6e9ed, #32353b))}\n.ds-button:focus-visible {outline:2px solid var(--primary, light-dark(#286fae, #3178b7));outline-offset:-2px}\n.ds-button:disabled {opacity:.5;pointer-events:none}"
    },
    {
      "name": "确认清除",
      "kind": "button",
      "refersTo": "button-destructive",
      "description": "在确认弹窗中清除所选服务的历史。",
      "html": "<button type=\"button\" class=\"ds-button\">清除历史</button>",
      "css": ":host { color-scheme: light dark; }\n.ds-button {display:inline-flex;align-items:center;justify-content:center;height:32px;padding:4px 12px;border:0;border-radius:6px;font:500 13px/20px -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif;cursor:pointer;background:var(--destructive, light-dark(#bd354b, #e47786));color:var(--primary-foreground, #fff)}\n.ds-button:hover {background:color-mix(in srgb, var(--destructive, light-dark(#bd354b, #e47786)) 90%, transparent)}\n.ds-button:focus-visible {outline:2px solid var(--primary-foreground, #fff);outline-offset:-3px}\n.ds-button:disabled {opacity:.5;pointer-events:none}\n@media (prefers-color-scheme: dark) {.ds-button {background:color-mix(in srgb,var(--destructive, light-dark(#bd354b, #e47786)) 60%,transparent)}.ds-button:hover {background:color-mix(in srgb,var(--destructive, light-dark(#bd354b, #e47786)) 90%,transparent)}}"
    },
    {
      "name": "刷新间隔",
      "kind": "input",
      "refersTo": "input",
      "description": "原生数字输入保留步进和内侧焦点。",
      "html": "<label class=\"ds-field\">刷新间隔（秒）<input class=\"ds-input\" type=\"number\" min=\"30\" value=\"60\"></label>",
      "css": ":host { color-scheme: light dark; }\n.ds-field {display:grid;gap:7px;color:var(--foreground, light-dark(#252629, #e9eaed));font:12px -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif}\n.ds-input {height:32px;padding:4px 9px;border:1px solid var(--input, light-dark(#d7d9dd, #424650));border-radius:6px;background:var(--card, light-dark(#fff, #202125));color:var(--foreground, light-dark(#252629, #e9eaed));font:13px/20px -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif}\n.ds-input:focus-visible {outline:2px solid var(--primary, light-dark(#286fae, #3178b7));outline-offset:-2px;border-color:var(--primary, light-dark(#286fae, #3178b7))}"
    },
    {
      "name": "主导航",
      "kind": "nav",
      "refersTo": "sidebar-item",
      "description": "当前页使用蓝底白字，设置与三个数据入口分隔。",
      "html": "<nav class=\"ds-nav\" aria-label=\"主导航\"><button type=\"button\" class=\"ds-nav-item\" aria-current=\"page\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 16v5\"></path><path d=\"M16 14.639V21\"></path><path d=\"M20 10.656V21\"></path><path d=\"m22 3-8.646 8.646a.5.5 0 0 1-.708 0L9.354 8.354a.5.5 0 0 0-.707 0L2 15\"></path><path d=\"M4 18.463V21\"></path><path d=\"M8 14.656V21\"></path></svg>用量</button><button type=\"button\" class=\"ds-nav-item\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 5h.01\"></path><path d=\"M3 12h.01\"></path><path d=\"M3 19h.01\"></path><path d=\"M8 5h13\"></path><path d=\"M8 12h13\"></path><path d=\"M8 19h13\"></path></svg>明细</button><button type=\"button\" class=\"ds-nav-item\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 12c.552 0 1.005-.449.95-.998a10 10 0 0 0-8.953-8.951c-.55-.055-.998.398-.998.95v8a1 1 0 0 0 1 1z\"></path><path d=\"M21.21 15.89A10 10 0 1 1 8 2.83\"></path></svg>额度</button><button type=\"button\" class=\"ds-nav-item\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915\"></path><circle cx=\"12\" cy=\"12\" r=\"3\"></circle></svg>设置</button></nav>",
      "css": ":host { color-scheme: light dark; }\n.ds-nav {display:grid;gap:3px;width:168px;padding:12px;background:var(--sidebar, light-dark(#f2f3f4, #131417))}\n.ds-nav-item {display:flex;align-items:center;gap:10px;min-height:36px;padding:0 10px;border:0;border-radius:6px;background:transparent;color:var(--foreground, light-dark(#252629, #e9eaed));font:400 13px -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif;cursor:pointer}\n.ds-nav-item:last-child {margin-top:12px}\n.ds-nav-item:hover {background:var(--accent, light-dark(#e6e9ed, #32353b))}\n.ds-nav-item[aria-current] {background:var(--primary, light-dark(#286fae, #3178b7));color:var(--primary-foreground, #fff);font-weight:600}\n.ds-nav-item:focus-visible {outline:2px solid var(--primary, light-dark(#286fae, #3178b7));outline-offset:-2px}\n.ds-nav-item[aria-current]:focus-visible {outline-color:var(--primary-foreground, #fff)}"
    },
    {
      "name": "额度趋势时段",
      "kind": "custom",
      "refersTo": "segmented",
      "description": "等宽的时段选项支持 Tab 和方向键。",
      "html": "<div class=\"ds-segments\" role=\"group\" aria-label=\"额度趋势时间范围\"><label class=\"ds-option\"><input type=\"radio\" name=\"period\" checked>24 小时</label><label class=\"ds-option\"><input type=\"radio\" name=\"period\">7 天</label></div>",
      "css": ":host { color-scheme: light dark; }\n.ds-segments {display:inline-grid;grid-template-columns:repeat(2,1fr);padding:3px;border-radius:7px;background:var(--secondary, light-dark(#eceef0, #2a2c31));font:12px/18px -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif}\n.ds-option {position:relative;display:grid;place-items:center;min-height:22px;padding:2px 10px;border-radius:5px;color:var(--muted, light-dark(#686c72, #a3a7af));cursor:pointer}\n.ds-option input {position:absolute;width:1px;height:1px;clip-path:inset(50%)}\n.ds-option:hover {color:var(--foreground, light-dark(#252629, #e9eaed))}\n.ds-option:has(:checked) {font-weight:500;color:var(--primary-foreground, #fff);background:var(--primary, light-dark(#286fae, #3178b7))}\n.ds-option:has(:focus-visible) {outline:2px solid var(--primary, light-dark(#286fae, #3178b7));outline-offset:-2px}\n.ds-option:has(:checked:focus-visible) {outline-color:var(--primary-foreground, #fff)}"
    },
    {
      "name": "额度窗口",
      "kind": "card",
      "refersTo": "quota-window",
      "description": "右侧读剩余比例，条下读重置时间。",
      "html": "<section class=\"ds-quota\"><div class=\"ds-row\"><span>5 小时额度</span><strong class=\"ds-reading\">72%</strong></div><div class=\"ds-track\" aria-hidden=\"true\"><span></span></div><div class=\"ds-times\"><span class=\"ds-count\"><b>3</b> 小时 <b>30</b> 分</span><span>重置 · 11/28 14:33</span></div></section>",
      "css": ":host { color-scheme: light dark; }\n.ds-quota {padding:18px;border:1px solid var(--border, light-dark(#dedfe2, #34363d));border-radius:10px;background:var(--card, light-dark(#fff, #202125));color:var(--foreground, light-dark(#252629, #e9eaed));font:13px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif;font-variant-numeric:tabular-nums}\n.ds-row,.ds-times {display:flex;align-items:baseline;justify-content:space-between;gap:8px;flex-wrap:wrap}\n.ds-reading {font-size:22px;font-weight:600;color:var(--quota-normal, light-dark(#63798c, #96adbf))}\n.ds-track {height:6px;background:var(--secondary, light-dark(#eceef0, #2a2c31));border-radius:3px;overflow:hidden;margin:8px 0}\n.ds-track span {display:block;width:72%;height:100%;border-radius:inherit;background:var(--quota-normal, light-dark(#63798c, #96adbf))}\n.ds-times {font-size:12px;color:var(--muted, light-dark(#686c72, #a3a7af))}\n.ds-count {color:var(--deadline-urgent, light-dark(#b45214, #efa063))}\n.ds-count b {font-weight:600}"
    },
    {
      "name": "模型占比",
      "kind": "custom",
      "refersTo": "model-share",
      "description": "Tokens 与费用使用相同的百分比尺度，数字与列标题右对齐。",
      "html": "<table class=\"ds-shares\"><thead><tr><th>Tokens 占比</th><th>费用占比</th></tr></thead><tbody><tr><td><span class=\"ds-share\" style=\"--ds-share:85.9%\">85.9%</span></td><td><span class=\"ds-share\" style=\"--ds-share:98.7%\">98.7%</span></td></tr></tbody></table>",
      "css": ":host { color-scheme: light dark; }\n.ds-shares {border-collapse:collapse;color:var(--foreground, light-dark(#252629, #e9eaed));background:var(--card, light-dark(#fff, #202125));font:12px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif;font-variant-numeric:tabular-nums}\n.ds-shares th {padding:10px 13px;text-align:right;color:var(--muted, light-dark(#686c72, #a3a7af));font-weight:500;border-bottom:1px solid var(--border, light-dark(#dedfe2, #34363d))}\n.ds-shares td {width:100px;padding:10px 4px;text-align:right}\n.ds-share {display:block;position:relative;isolation:isolate;border-radius:2px;overflow:hidden;line-height:26px;padding-right:9px;background:color-mix(in srgb,var(--muted, light-dark(#686c72, #a3a7af)) 6%,transparent)}\n.ds-share::before {content:\"\";position:absolute;inset:0 auto 0 0;width:var(--ds-share, 0%);background:color-mix(in srgb,var(--primary, light-dark(#286fae, #3178b7)) 29%,transparent);z-index:-1}"
    },
    {
      "name": "公告来源",
      "kind": "chip",
      "refersTo": "source-badge",
      "description": "公开重置动态标题旁的来源标签。",
      "html": "<span class=\"ds-tag\">AIHOT</span>",
      "css": ":host { color-scheme: light dark; }\n.ds-tag {display:inline-block;padding:1px 6px;border-radius:4px;background:var(--secondary, light-dark(#eceef0, #2a2c31));color:var(--muted, light-dark(#686c72, #a3a7af));font:500 10px/14px -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif;letter-spacing:.02em}"
    }
  ],
  "narrative": {
    "northStar": "紧凑的桌面仪表盘",
    "overview": "在 Codex Quota 的桌面主窗口里，开发者既能快速判断还剩多少额度，也能查到哪个模型或项目消耗最多。额度页把剩余比例和重置时间放在同一视线内。用量页先给出总数，再让人沿着趋势、模型和单条记录核对消耗。\n\n侧栏和页头提供稳定的位置。最大的字留给读数。期间、单位和数据来源贴近对应数字。控件使用简短中文名称，Codex、Antigravity 和模型名保留原文。",
    "keyCharacteristics": [
      "用量、明细、额度、设置四个入口共用一个桌面窗口。",
      "跟随系统浅深色，以系统字体和等宽数字呈现密集数据。",
      "颜色分别表达所选项、服务、额度状态和剩余时间。",
      "未知、未定价、过期和真实零值各有对应的显示方式。"
    ],
    "rules": [],
    "dos": [
      "Do 让数字与其单位、时段和来源靠近。紧凑显示的计数提供查看完整值的入口。",
      "Do 使用当前主题和控件已有的尺寸、变体，保留原生选择、键盘操作与内侧焦点。",
      "Do 用文字、符号或图例与颜色共同表达服务、状态和变化。"
    ],
    "donts": [
      "Don't 用 0% 或满格进度条填补未知额度，将缺失定价显示为免费，或将过期快照显示为刚刚读取。",
      "Don't 为解释布局重复写标题、提示或状态标签。保留能帮助用户选择、核对或处理错误的文字。"
    ]
  }
}
