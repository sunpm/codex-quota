  "narrative": {
    "northStar": "原生仪表盘",
    "overview": "克制、清晰、紧凑。界面帮助用户查看额度、比较用量，以稳定的数字、明确的分组和系统控件建立秩序。识别来自 Codex 标识与细节的一致性；正文、数据和操作优先于装饰。\n\n这是原生 macOS 视觉规范，最低系统版本为 macOS 13。保留 SwiftUI / AppKit 的字体、控件、焦点、菜单和窗口惯例；macOS 26 及以上的部分控件使用系统 Liquid Glass。使用简体中文，保留服务名、模型名、Tokens、USD 等必要标识。产品约束见 [PRODUCT.md](PRODUCT.md)，实现与协作约束见 [AGENTS.md](AGENTS.md)。",
    "keyCharacteristics": [
      "系统字体与语义颜色适应系统外观，额度状态使用独立的语义色。",
      "用底色、细边框、留白和对齐表达层次，操作使用原生控件。",
      "数值便于比较；来源、时间、单位、未知和过期状态贴近对应数据。",
      "文案具体简短，保留表单标签与必要口径，删除重复解释布局的说明。"
    ],
    "rules": [
      {
        "name": "状态归属",
        "body": "额度颜色只由真实剩余值决定；品牌色、图表类别和显示舍入不改变它。",
        "section": "colors"
      },
      {
        "name": "可比较数字",
        "body": "同列数值保持相同字级、对齐和单位口径；缩写不移除完整值的查看入口。",
        "section": "typography"
      },
      {
        "name": "系统材质",
        "body": "材质与控件状态交给平台；用自定义表面时，复用 `panelCard()` 的底色和边框。",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** 复用 `PanelTypography.detail`、`PanelButtonStyle`、`panelCard()` 与 `quotaColor`。",
      "**Do** 保留系统色和原生控件的语义，分别处理品牌、图表类别与额度状态。",
      "**Do** 用等宽数字、右对齐和一致单位支持比较，把来源、时间与必要口径贴近数据。",
      "**Do** 为截断名称保留完整值入口，为未知、部分和过期状态保留明确文字。",
      "**Do** 使用简短中文控件名，保留表单标签和必要错误信息。"
    ],
    "donts": [
      "**Don't** 从一张浅色截图固化系统背景、强调色、字体度量或玻璃材质。",
      "**Don't** 为了装饰增加大面积自造背景、阴影层级、字体或动画系统。",
      "**Don't** 用颜色独自表达类别或错误，也不要把未知额度显示成满额、缺价显示成免费。",
      "**Don't** 让长名称挤走核心数字，或把重要读取警告放到长页面末尾。",
      "**Don't** 把 HTML 示意、源码支持或单次窗口检查写成全尺寸、深色或无障碍验收通过。"
    ]
  }
}
