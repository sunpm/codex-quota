---
import { Icon } from '@astrojs/starlight/components'
import Hero from '@astrojs/starlight/components/Hero.astro'

const release = 'https://github.com/sunpm/codex-quota/releases/latest/download/'
const downloads = [
  { platform: 'macOS', arch: 'Apple Silicon', file: 'CodexQuota-macOS-AppleSilicon.dmg' },
  { platform: 'macOS', arch: 'Intel', file: 'CodexQuota-macOS-Intel.dmg' },
  { platform: 'Windows', arch: 'x64', file: 'CodexQuota-Windows-x64-setup.exe' },
]
---

{Astro.locals.starlightRoute.id === '' ? <div class="intro">
  <div class="summary">
    <h1 id="_top" data-page-title>额度与用量，<br />一窗看清。</h1>
    <p>查看 Codex 与 Antigravity 的剩余额度和重置时间，按模型、对话和项目分析本机 Token 用量与估算费用。</p>
    <a href="./usage/"><Icon name="open-book" size="1.1em" />使用说明</a>
  </div>
  <section class="downloads" aria-labelledby="download-heading">
    <h2 id="download-heading">下载 Codex Quota</h2>
    <ul>
      {downloads.map(({ platform, arch, file }) => (
        <li>
          <a href={release + file} aria-label={`下载 ${platform} ${arch} 安装包`}>
            <strong>{platform}</strong><span>{arch}</span><Icon name="download" size="1.25em" />
          </a>
        </li>
      ))}
    </ul>
    <a class="guide" href="./install/">安装与首次打开</a>
  </section>
</div> : <Hero />}

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(16rem, 0.85fr);
    gap: clamp(2rem, 8vw, 7rem);
    align-items: center;
    padding-block: clamp(1.75rem, 5vw, 4.25rem);
  }
  h1 {
    font-size: clamp(2.75rem, 6vw, 4.75rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
    font-weight: 700;
  }
  .summary p {
    max-width: 32rem;
    margin-block: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.8;
  }
  a { text-underline-offset: 0.23em; }
  .summary a { display: inline-flex; align-items: center; gap: 0.4rem; }
  h2 { font-size: 1.125rem; font-weight: 650; }
  ul { list-style: none; padding: 0; margin-block: 0.75rem; }
  li { border-block-start: 1px solid var(--sl-color-hairline); }
  li:last-child { border-block-end: 1px solid var(--sl-color-hairline); }
  li a {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.85rem 0.5rem;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  li a:hover, li a:focus-visible { background: var(--sl-color-accent-low); }
  li span, .guide { font-size: 0.9375rem; }
  li span { color: var(--sl-color-gray-2); }
  li :global(svg) { align-self: center; margin-inline-start: auto; color: var(--sl-color-accent-high); }
  a:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: -2px; }
  @media (max-width: 44rem) {
    .intro { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
